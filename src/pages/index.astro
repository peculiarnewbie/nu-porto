---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="absolute z-20 w-full bg-black">
			<div
				class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0"
			>
				<div class="lg:flex lg:justify-between lg:gap-4">
					<Header />
					<main class="flex min-h-screen flex-col pt-24 lg:w-1/2 lg:py-24">
						<p class="text-slate-400">
							{
								"Hi there. I'm Arif, though my friends call me Bolt (it's a long story)"
							}
						</p>
						<p class="mt-4 text-slate-400">
							{
								"I've been creating games since 2017 and focused on it while studying CompSci. In mid 2023 I tried creating an actual web project and immediately fell in love with frontend development"
							}
						</p>
						<div class="pt-16 lg:pt-12"></div>
						<p class="pb-8 font-bold tracking-widest text-slate-200">MY PROJECTS</p>
						<div class="flex flex-col gap-12">
							<!-- {#each projects as project, index}
			<ProjectItem {project} />
		{/each} -->
						</div>
						<div class="pt-16 text-sm text-slate-400 sm:pb-0">
							{"This website was built using"}
							<span class="Lib"
								><a href="https://kit.svelte.dev/" target="_blank">Sveltekit</a
								></span
							>
							{", "}
							<span class="Lib"
								><a href="https://tailwindcss.com/" target="_blank">Tailwind CSS</a
								></span
							>
							{", "}
							<span class="Lib"
								><a href="https://threlte.xyz/" target="_blank">Threlte</a></span
							>{", "}
							<span class="Lib"
								><a href="https://turso.tech/" target="_blank">Turso</a></span
							>
							{", "}
							<span class="Lib"
								><a href="https://orm.drizzle.team/" target="_blank">Drizzle ORM</a
								></span
							>{", and deployed on "}
							<span class="Lib"
								><a href="https://pages.cloudflare.com/" target="_blank"
									>Cloudflare Pages</a
								></span
							>
						</div>
						<div class="pt-4 text-sm text-slate-400 sm:pb-0">
							{"Design is heavily inspired by "}
							<span class="Lib"
								><a href="https://brittanychiang.com/" target="_blank"
									>{"Brittany Chiang"}</a
								></span
							>{"'s portofolio"}
						</div>
						<div class="pb-16 pt-4 text-sm text-slate-400 sm:pb-0">
							{"Feel free to checkout this website's repo "}<span class="Lib"
								><a
									href="https://github.com/peculiarnewbie/nu-porto"
									target="_blank">here</a
								></span
							>
						</div>
					</main>
				</div>
			</div>
		</div>
		<!-- <Footer /> -->
	</body>
</html>
